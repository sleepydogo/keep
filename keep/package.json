{
  "name": "@keep/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,magenta \"npm run dev:api\" \"npm run dev:ui\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@keep/contract": "*",
    "@midnames/sdk": "^2.0.1",
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.2.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "qr-scanner": "^1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-wasm": "^3.6.0"
  }
}
