{
  "name": "keep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "workspaces": [
    "contract",
    "ward",
    "keep"
  ],
  "scripts": {
    "compact": "npm run compact -w @keep/contract",
    "deploy": "npm run deploy -w @keep/contract",
    "registrar": "npm run registrar -w @keep/contract",
    "presentar": "npm run presentar -w @keep/contract",
    "dev": "concurrently -k -i --default-input-target ward -n api,web,ward -c green,magenta,cyan npm:dev:api npm:dev:web npm:dev:ward",
    "dev:api": "npm run dev:api -w @keep/web",
    "dev:web": "npm run dev:ui -w @keep/web",
    "dev:ward": "npm run start -w ward.app -- --port 5173",
    "test": "npm run ci -w @keep/contract"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.61.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "allowScripts": {
    "classic-level@3.0.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
