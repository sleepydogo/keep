# Copiar a .env. No commitear .env.

# Wallet que publica el contrato, fondeada y generando DUST.
# Si viene de una frase BIP39 (Lace), derivarla con PBKDF2 — ver README.
# NO es la frase hexeada como texto: eso deriva otra wallet, vacía y sin error.
KEEP_DEPLOY_SEED=

# Identidad del emisor. Hex de 64. NO necesita fondos: de acá sale el emisorId.
KEEP_EMISOR_SECRET=

# Lo devuelve `npm run deploy`.
KEEP_CONTRACT_ADDRESS=

# Browser. Van al bundle: son de testnet y de demo, nada más.
VITE_HOLDER_SEED=
VITE_CONTRACT_ADDRESS=
